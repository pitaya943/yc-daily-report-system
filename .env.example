# Local development / CI test placeholders only — never commit real secrets.

# Supabase (local `supabase start` defaults)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=your-local-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# NestJS API
API_PORT=3001
API_URL=http://127.0.0.1:3001
SESSION_SECRET=replace-with-random-test-secret-min-32-chars
SESSION_IDLE_MINUTES=30

# Bank encryption (test key only in CI/local)
BANK_ENCRYPTION_KEY_BASE64=replace-with-test-only-32-byte-key-base64

# Next.js web
NEXT_PUBLIC_API_URL=http://127.0.0.1:3001

# Seed passwords (local/CI fixtures only)
SEED_PASSWORD=seedpass01
